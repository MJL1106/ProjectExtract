{
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "--with",
        "sentence-transformers",
        "code-review-graph",
        "serve"
      ],
      "type": "stdio"
    },
    "unreal-editor": {
      "type": "http",
      "url": "http://127.0.0.1:9315/mcp"
    },
    "VibeUE": {
      "type": "http",
      "url": "http://127.0.0.1:8088/mcp"
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "type": "stdio"
    }
  }
}
